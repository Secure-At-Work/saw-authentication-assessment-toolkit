# Generated report output (may contain customer-identifying findings)
reports/*
!reports/.gitkeep

# sampledata/ holds committed synthetic fixtures used for offline dev/testing -
# it is intentionally NOT gitignored. Real per-tenant collector output has no
# committed home yet; when that lands, gitignore its actual output path here
# (not sampledata/, which must stay fixture-only).

# Local, tenant-specific configuration (never commit tenant/group/policy IDs)
config/config.json

# PowerShell / editor
*.ps1xml.bak
.vscode/
*.log
